        <!-- ========= Lombok ========= -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ========= Helpers (con exclusiones para dejar solo Logback) ========= -->
        <dependency>
            <groupId>local.jarios</groupId>
            <artifactId>encrypt-helper</artifactId>
            <version>${encrypt-helper.version}</version>
        </dependency>

        <dependency>
            <groupId>local.jarios</groupId>
            <artifactId>version-helper</artifactId>
            <version>${version-helper.version}</version>
        </dependency>

        <dependency>
            <groupId>local.jarios</groupId>
            <artifactId>email-helper</artifactId>
            <version>${email-helper.version}</version>
