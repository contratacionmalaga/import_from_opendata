<FindBugsFilter>
    <Match>
        <Class name="local.jarios.parsers.InternetFeedSource"/>
        <Method name="openBufferedReader"/>
        <Bug pattern="URLCONNECTION_SSRF_FD"/>
    </Match>
    <Match>
        <Class name="local.jarios.parsers.LocalFeedSource"/>
        <Method name="getPathBaseLocal"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
    <!--
      La traza del correo se construye para soporte y se depura mediante
      sanitizeSensitiveText antes de devolverla. La prueba de correo de
      soporte verifica la ocultación de contraseñas y tokens.
    -->
    <Match>
        <Class name="local.jarios.email.ExecutionEmailReportBuilder"/>
        <Method name="sanitizeAndLimitStackTrace"/>
        <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/>
    </Match>
    <!-- Los valores incorporados al HTML se codifican con escape antes de renderizarse. -->
    <Match>
        <Class name="local.jarios.email.ExecutionEmailReportBuilder"/>
        <Method name="appendBar"/>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
    </Match>
    <Match>
        <Class name="local.jarios.email.ExecutionEmailReportBuilder"/>
        <Method name="buildSuccessBody"/>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
    </Match>
</FindBugsFilter>
