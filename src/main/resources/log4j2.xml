<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <!-- Consola -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-25c{1}:%-4L - %m%n"/>
        </Console>

        <!-- Archivos de Registro -->
        <!-- Registro generado por el Aplicativo -->
        <File name="MainAppLogFile" fileName="logs/mainapp-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <File name="PropertiesHelper" fileName="logs/properties_helper-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- Registro generado por Properties_Helper -->
        <File name="EmailHelper" fileName="logs/email_helper-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- Registro generado por Properties_Helper -->
        <File name="EncryptHelper" fileName="logs/encrypt_helper-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- Registro generado por Properties_Helper -->
        <File name="VersionHelper" fileName="logs/version_helper-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- Registro generado por Hibernate -->
        <File name="FileHibernate" fileName="logs/hibernate-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- Registro generado por Hibernate -->
        <File name="FilePersistence" fileName="logs/hibernate_persistence-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- Registro generado por Hibernate -->
        <File name="FileHibernateSQL" fileName="logs/hibernate_sql-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- Registro generado por Reflections para obtener las entidades gestionadas por Hibernate -->
        <File name="FileReflections" fileName="logs/reflection-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- -->
        <File name="FileHikariCP" fileName="logs/hikaricp-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-30c{1}:%-4L - %m%n"/>
        </File>

        <!-- Registro generado por Apache POI para el acceso a los ficheros excels -->
        <File name="FileApachePoi" fileName="logs/apache_poi-${date:yyyy-MM-dd_HH-mm-ss}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %30c{1}:%-4L - %m%n"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- Busqueda de entidades en la ruta seleccionada -->
        <Logger name="local.jarios.properties" level="INFO" additivity="true">
            <AppenderRef ref="PropertiesHelper"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Busqueda de entidades en la ruta seleccionada -->
        <Logger name="local.jarios.email" level="INFO" additivity="false">
            <AppenderRef ref="EmailHelper"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Busqueda de entidades en la ruta seleccionada -->
        <Logger name="local.jarios.encrypt" level="INFO" additivity="false">
            <AppenderRef ref="EncryptHelper"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Busqueda de entidades en la ruta seleccionada -->
        <Logger name="local.jarios.version" level="INFO" additivity="false">
            <AppenderRef ref="VersionHelper"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Busqueda de entidades en la ruta seleccionada -->
        <Logger name="org.reflections.Reflections" level="INFO" additivity="false">
            <AppenderRef ref="FileReflections"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Busqueda de entidades en la ruta seleccionada -->
        <Logger name="org.apache.poi" level="INFO" additivity="false">
            <AppenderRef ref="FileApachePoi"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Redirección del log de hibernate. Almacenado en fichero. -->
        <Logger name="org.hibernate" level="INFO" additivity="false">
            <AppenderRef ref="FileHibernate"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="javax.persistence" level="INFO" additivity="false">
            <AppenderRef ref="FilePersistence"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Logger name="org.hibernate.SQL" level="INFO" additivity="false">
            <AppenderRef ref="FileHibernateSQL"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Configurar el logger para los logs de HikariCP -->
        <logger name="com.zaxxer.hikari" level="INFO" additivity="false">
            <AppenderRef ref="FileHikariCP"/>
            <AppenderRef ref="Console"/>
        </logger>

        <Logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="INFO" additivity="false">
            <AppenderRef ref="FileHibernate"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Busqueda de entidades en la ruta seleccionada -->
        <Logger name="local.jarios" level="INFO" additivity="false">
            <AppenderRef ref="MainAppLogFile"/>
            <AppenderRef ref="Console"/>
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="MainAppLogFile"/>
            <AppenderRef ref="Console"/>
        </Root>

    </Loggers>
</Configuration>