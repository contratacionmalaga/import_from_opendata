<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <!-- Consola -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-15c{1}:%-4L - %m%n" />
        </Console>

        <!-- Archivos de Registro -->
        <!-- Registro generado por el Aplicativo -->
        <File name="File" fileName="logs/local-log4j2-${date:yyyy-MM-dd_HH-mm-ss}-log.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-15c{1}:%-4L - %m%n" />
        </File>

        <!-- Registro generado por Hibernate -->
        <File name="FileHibernate" fileName="logs/local-log4j2-${date:yyyy-MM-dd_HH-mm-ss}-hibernate.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-15c{1}:%-4L - %m%n" />
        </File>

        <!-- Registro generado por Hibernate -->
        <File name="FilePersistence" fileName="logs/local-log4j2-${date:yyyy-MM-dd_HH-mm-ss}-hibernate-persistence.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-15c{1}:%-4L - %m%n" />
        </File>

        <!-- Registro generado por Hibernate -->
        <File name="FileHibernateSQL" fileName="logs/local-log4j2-${date:yyyy-MM-dd_HH-mm-ss}-hibernate-sql.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-15c{1}:%-4L - %m%n" />
        </File>

        <!-- Registro generado por Reflections para obtener las entidades gestionadas por Hibernate -->
        <File name="FileReflections" fileName="logs/local-log4j2-${date:yyyy-MM-dd_HH-mm-ss}-reflection.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-15c{1}:%-4L - %m%n" />
        </File>

        <!-- -->
        <File name="FileHikariCP" fileName="logs/local-log4j2-${date:yyyy-MM-dd_HH-mm-ss}-hikaricp.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-15c{1}:%-4L - %m%n" />
        </File>
    </Appenders>

    <Loggers>

        <!-- Busqueda de entidades en la ruta seleccionada -->
        <Logger name="org.reflections.Reflections" level="INFO" additivity="false">
            <AppenderRef ref="FileReflections"/>
        </Logger>

        <!-- Redirección del log de hibernate. Almacenado en fichero. -->
        <Logger name="org.hibernate" level="INFO" additivity="false">
            <AppenderRef ref="FileHibernate"/>
        </Logger>

        <Logger name="javax.persistence" level="INFO" additivity="false">
            <AppenderRef ref="FilePersistence"/>
        </Logger>

        <Logger name="org.hibernate.SQL" level="INFO" additivity="false">
            <AppenderRef ref="FileHibernateSQL"/>
        </Logger>

        <!-- Configurar el logger para los logs de HikariCP -->
        <logger name="com.zaxxer.hikari" level="INFO" additivity="false">
            <AppenderRef ref="FileHikariCP" />
        </logger>

        <Logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="INFO" additivity="false">
            <AppenderRef ref="FileHibernate"/>
        </Logger>

        <!-- Redirección del log del aplicativo. Por consola y almacenado en fichero. -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>

    </Loggers>
</Configuration>