# Conexion JDBC opcional para filtros SQL.
# Copiar este fichero a jakarta_filtro.properties solo si el flujo usado requiere una conexion de filtros independiente.

jakarta.persistence.jdbc.url=jdbc:mariadb://localhost:3306/import_from_opendata_filtros?useUnicode=true\
&characterEncoding=utf8mb4\
&connectionCollation=utf8mb4_unicode_ci\
&connectionCollationForce=true\
&serverTimezone=Europe/Madrid\
&rewriteBatchedStatements=true
jakarta.persistence.jdbc.driver=org.mariadb.jdbc.Driver
jakarta.persistence.jdbc.user=CHANGE_ME_FILTER_DB_USER
jakarta.persistence.jdbc.password=CHANGE_ME_FILTER_DB_PASSWORD